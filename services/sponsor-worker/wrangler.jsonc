{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "s2s-sponsor-worker",
  "main": "index.js",
  "compatibility_date": "2026-11-03",
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23li1Cz7fdt9bXFKPh",
